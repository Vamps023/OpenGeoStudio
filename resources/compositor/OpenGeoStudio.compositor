// ============================================================
// OpenGeoStudio — 3D Studio shadow node
// ============================================================
//
// PSSM (cascaded) shadow maps for the directional sun light. The 3D Studio
// workspace is created in C++ via CompositorManager2::createBasicWorkspaceDef,
// which takes this node's name and assigns it to its render_scene pass.
//
// Three splits are packed into a single depth atlas:
//   split 0 — nearest to the camera, gets half the atlas for maximum detail
//   split 1 — mid range
//   split 2 — far range
//
// Layout mirrors OGRE-Next's own Tutorial_Terrain shadow node, which is the
// proven configuration for large outdoor terrain scenes.

compositor_node_shadow OgsShadowNode
{
	technique pssm

	texture atlas 3072 2048 PFG_D32_FLOAT

	num_splits		3
	pssm_lambda		0.95
	shadow_map 0 atlas uv 0.000000000000000 0.0 0.666666666666667 1.0 light 0 split 0
	shadow_map 1 atlas uv 0.666666666666667 0.0 0.333333333333333 0.5 light 0 split 1
	shadow_map 2 atlas uv 0.666666666666667 0.5 0.333333333333333 0.5 light 0 split 2

	target atlas
	{
		pass clear
		{
			colour_value 1 1 1 1
		}
	}

	shadow_map_target_type directional
	{
		shadow_map 0 1 2
		{
			pass render_scene
			{
			}
		}
	}
}
