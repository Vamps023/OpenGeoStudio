@echo off
REM Auto-generated test wrapper — sets up PATH for Qt and QMapLibre DLLs
REM before running the test executable. Do not edit manually.
setlocal
set "PATH=@_qt_bin_dir@;@_qmlib_dir@;%PATH%"
set "PROJ_LIB=%~dp0proj"
set "QT_QPA_PLATFORM=offscreen"
REM OGS_SKIP_ROAD_MODEL_TESTS is no longer set by default — road model
REM tests now run with an increased stack size (16MB) to avoid stack
REM overflow in LaneMaker junction tests. Set the env var manually to
REM skip them if needed.
"%~1" %2 %3 %4 %5 %6 %7 %8 %9
