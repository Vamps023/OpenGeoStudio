{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeostudio.dev/schemas/ogproj-schema.json",
  "title": "OpenGeoStudio Project File (.ogproj)",
  "description": "JSON Schema for the OpenGeoStudio project file format. Extracted from core/project/project-manager.ts (Project interface) and modules/road-studio/shared/types.ts (Road, ControlPoint, SegmentMetadata, RoadProfile). This is the interop contract between the Electron/TypeScript app and the Qt/C++ app during the migration transition.",
  "type": "object",
  "required": ["id", "name", "createdAt", "modifiedAt", "workspaceId", "moduleState", "dirty"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique project ID (e.g. 'project-1')"
    },
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "filePath": {
      "type": "string",
      "description": "File path (if saved). Set by ProjectManager on open/save."
    },
    "basePath": {
      "type": "string",
      "description": "Project base folder — all auto-managed subfolders live here. Derived from filePath if absent (legacy)."
    },
    "createdAt": {
      "type": "string",
      "description": "ISO 8601 timestamp of creation"
    },
    "modifiedAt": {
      "type": "string",
      "description": "ISO 8601 timestamp of last modification"
    },
    "bounds": {
      "type": "object",
      "description": "Map bounds (optional, used by Terrain workspace)",
      "additionalProperties": false,
      "required": ["north", "south", "east", "west"],
      "properties": {
        "north": { "type": "number" },
        "south": { "type": "number" },
        "east": { "type": "number" },
        "west": { "type": "number" }
      }
    },
    "workspaceId": {
      "type": "string",
      "description": "Active workspace ID ('home', 'terrain', 'road-studio', 'train-studio')"
    },
    "moduleState": {
      "type": "object",
      "description": "Module-specific state. Keys are module IDs ('road-studio', 'train-studio', 'terrain'). Unknown keys must be preserved as opaque JSON for forward compatibility.",
      "additionalProperties": true,
      "properties": {
        "road-studio": {
          "$ref": "#/$defs/RoadStudioState"
        },
        "train-studio": {
          "description": "Train Studio state (tracks array). Schema to be expanded from modules/train-studio/shared/types.ts.",
          "type": "object",
          "additionalProperties": true
        },
        "terrain": {
          "description": "Terrain state (bounds, export settings). Schema to be expanded from modules/terrain/shared/terrain.ts.",
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "dirty": {
      "type": "boolean",
      "description": "Whether the project has unsaved changes"
    }
  },

  "$defs": {
    "RoadStudioState": {
      "type": "object",
      "description": "Road Studio module state, stored under moduleState['road-studio']",
      "additionalProperties": true,
      "properties": {
        "roads": {
          "type": "array",
          "items": { "$ref": "#/$defs/Road" }
        }
      }
    },

    "Road": {
      "type": "object",
      "description": "A road — a sequence of control points forming a path",
      "required": ["id", "name", "points", "width", "laneCount", "color", "profile", "startIntersectionId", "endIntersectionId"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique road ID"
        },
        "name": {
          "type": "string",
          "description": "Road display name"
        },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/ControlPoint" },
          "description": "Sequence of control points forming the road path"
        },
        "width": {
          "type": "number",
          "description": "Road width in meters",
          "minimum": 0
        },
        "laneCount": {
          "type": "integer",
          "description": "Number of lanes",
          "minimum": 0
        },
        "color": {
          "type": "string",
          "description": "Visual color (CSS color string)"
        },
        "profile": { "$ref": "#/$defs/RoadProfile" },
        "startIntersectionId": {
          "type": ["string", "null"],
          "description": "Intersection node at the start of the road (null if none)"
        },
        "endIntersectionId": {
          "type": ["string", "null"],
          "description": "Intersection node at the end of the road (null if none)"
        },
        "formatVersion": {
          "type": "integer",
          "description": "Schema version (1=legacy, 2=with segmentMeta). Optional for backward compatibility.",
          "enum": [1, 2]
        }
      }
    },

    "ControlPoint": {
      "type": "object",
      "description": "A control point on a road — the fundamental editable unit",
      "required": ["id", "lat", "lon", "z", "handleIn", "handleOut", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique control point ID"
        },
        "lat": {
          "type": "number",
          "description": "Latitude (degrees)",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "description": "Longitude (degrees)",
          "minimum": -180,
          "maximum": 180
        },
        "z": {
          "type": "number",
          "description": "Elevation in meters"
        },
        "handleIn": {
          "type": ["object", "null"],
          "description": "Bezier handle for the incoming segment (relative offset from point). Null for corner points.",
          "$ref": "#/$defs/Vec2"
        },
        "handleOut": {
          "type": ["object", "null"],
          "description": "Bezier handle for the outgoing segment (relative offset from point). Null for corner points.",
          "$ref": "#/$defs/Vec2"
        },
        "type": {
          "type": "string",
          "enum": ["smooth", "corner"],
          "description": "Smooth points have handles, corner points do not"
        },
        "segmentMeta": {
          "type": ["object", "null"],
          "description": "Optional segment metadata for exact geometry reconstruction (formatVersion 2 only)",
          "$ref": "#/$defs/SegmentMetadata"
        }
      }
    },

    "Vec2": {
      "type": "object",
      "description": "2D vector in lat/lon space (used for bezier handle offsets)",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" }
      }
    },

    "SegmentMetadata": {
      "type": "object",
      "description": "Segment metadata for exact reconstruction of non-Bezier geometry (Phase 1.8.3d)",
      "required": ["kind", "version", "startHeading"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["line", "bezier", "arc", "spiral"],
          "description": "Geometry type"
        },
        "version": {
          "type": "integer",
          "description": "Metadata version number"
        },
        "startHeading": {
          "type": "number",
          "description": "Heading at segment start (radians)"
        },
        "curvature": {
          "type": "number",
          "description": "Arc curvature (1/radius). Present when kind='arc'."
        },
        "arcLength": {
          "type": "number",
          "description": "Arc length in meters. Present when kind='arc'."
        },
        "curvatureStart": {
          "type": "number",
          "description": "Spiral start curvature. Present when kind='spiral'."
        },
        "curvatureEnd": {
          "type": "number",
          "description": "Spiral end curvature. Present when kind='spiral'."
        },
        "segmentLength": {
          "type": "number",
          "description": "Spiral segment length in meters. Present when kind='spiral'."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "arc" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["curvature", "arcLength"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "spiral" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["curvatureStart", "curvatureEnd", "segmentLength"]
          }
        }
      ]
    },

    "RoadProfile": {
      "type": "object",
      "description": "SCANeR-style road profile — defines road type, surface, and lane config",
      "required": ["type", "surfaceTexture", "markingTexture", "laneWidth", "hasSidewalk", "hasCurb"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["city_2x1", "city_2x2", "country_2x1", "highway_2x3", "custom"],
          "description": "Profile type based on SCANeR profiles"
        },
        "surfaceTexture": {
          "type": "string",
          "description": "Surface texture name (from SCANeR textures)"
        },
        "markingTexture": {
          "type": "string",
          "description": "Lane marking texture name"
        },
        "laneWidth": {
          "type": "number",
          "description": "Lane width in meters",
          "minimum": 0
        },
        "hasSidewalk": {
          "type": "boolean",
          "description": "Has sidewalk?"
        },
        "hasCurb": {
          "type": "boolean",
          "description": "Has curb?"
        }
      }
    }
  }
}
